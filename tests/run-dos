#!/usr/bin/env perl

use 5.036;
use warnings;
use autodie qw(open close);
use File::Basename qw(basename);
use File::Copy qw(copy);
use File::Path qw(make_path remove_tree);
use File::Spec;

=head1 NAME

run-dos - run Tcl test scripts with a DOS TCL.EXE under DOSBox-X

=head1 SYNOPSIS

  tests/run-dos [-e ERR2OUT.EXE] [-f FILE]... TCL.EXE DIR...

=head1 DESCRIPTION

Each F<NAME.tcl> in each DIR is a case (NAME at most 8 characters). Its
expected standard output is F<NAME.out> next to it, compared after CRLF
is turned into LF. Comment lines at the top of the script can say:

  # status: N        the expected exit status (default 0)
  # command: ARGS    run TCL ARGS instead of TCL NAME.TCL
  # todo: REASON     a known failure: reported, but not counted as one
  # stderr: merged   run under ERR2OUT.EXE (-e), so that standard error
                     goes to standard output and NAME.out has both
  # host: skip       (tests/run-host only) not run with the host build

Any other file in DIR is a fixture, copied into the work directory
under its name in upper case, as is each FILE given with C<-f> (a test
tool, such as F<CHILD.EXE> for the exec cases).

A C<# command:> line may redirect standard input from a fixture
(C<# command: -i E<lt>REPL.IN>); the harness adds C<E<gt>NAME.OUT>.

COMMAND.COM cannot redirect standard error, so scripts report errors on
standard output themselves, with C<catch>, or the case says
C<# stderr: merged> and runs as C<ERR2OUT TCL ...>
(F<tests/tools/err2out.c>), which sends TCL.EXE's standard error to its
standard output. TCL.EXE flushes standard output before it writes a
diagnostic, so the two keep their order.

Each case runs in its own DOSBox-X session, on an emulated 8086 (core
normal, cputype 8086, CGA machine) with C: mounted on a work directory
(F<build/run-dos>, or WORK) holding TCL.EXE and the cases, and is killed if it
takes longer than DOSBOX_TIMEOUT seconds. Exits 0 if every case not
marked todo passes.

Environment: DOSBOX (default dosbox-x), DOSBOX_TIMEOUT seconds per case
(default 60), KEEP=1 to keep the work directory, WORK the work directory.

Adapted from gr-dos/perl16's tests/run-dos.

=cut

my ($err2out, @extra);
while (@ARGV >= 2 && $ARGV[0] =~ /^-[ef]$/) {
    my ($opt, $val) = splice @ARGV, 0, 2;
    if ($opt eq '-e') { $err2out = $val } else { push @extra, $val }
}
my ($exe, @dirs) = @ARGV;
die "usage: $0 [-e ERR2OUT.EXE] [-f FILE]... TCL.EXE DIR...\n" unless @dirs;
-f $_ or die "$_ not found\n" for @extra;
die "$exe not found\n" unless -f $exe;
die "$err2out not found\n" if defined $err2out && !-f $err2out;
my $dosbox = $ENV{DOSBOX} // 'dosbox-x';
my $timeout = $ENV{DOSBOX_TIMEOUT} // 60;

my $work = File::Spec->rel2abs($ENV{WORK} // 'build/run-dos');
remove_tree($work);
make_path($work);
copy($exe, "$work/TCL.EXE") or die "copy $exe: $!\n";
copy($err2out, "$work/ERR2OUT.EXE") or die "copy $err2out: $!\n"
    if defined $err2out;

sub slurp ($f) { open my $h, '<:raw', $f; local $/; my $s = <$h>; close $h; $s }

my (@cases, %seen);
for my $dir (@dirs) {
    for my $t (sort glob "$dir/*.tcl") {
        my $name = uc basename($t, '.tcl');
        die "$t: name longer than 8 characters\n" if length $name > 8;
        die "$t: $name is used twice\n" if $seen{$name}++;
        my %case = (name => $name, file => $t, status => 0,
                    command => "TCL $name.TCL");
        for (split /\n/, slurp($t)) {
            last unless /^#/;
            $case{status}  = $1 if /^#\s*status:\s*(\d+)/;
            $case{command} = "TCL $1" if /^#\s*command:\s*(.+?)\s*$/;
            $case{todo}    = $1 if /^#\s*todo:\s*(.+?)\s*$/;
            $case{merged}  = 1 if /^#\s*stderr:\s*merged\s*$/;
        }
        if ($case{merged}) {
            die "$t: # stderr: merged needs -e ERR2OUT.EXE\n"
                unless defined $err2out;
            $case{command} = "ERR2OUT $case{command}";
        }
        (my $exp = $t) =~ s/\.tcl$/.out/;
        die "$t: no $exp\n" unless -f $exp;
        $case{expect} = slurp($exp);
        copy($t, "$work/$name.TCL") or die "copy $t: $!\n";
        push @cases, \%case;
    }
}
die "no cases\n" unless @cases;

for my $f (@extra) {
    my $name = uc basename($f);
    die "$f: $name is used twice\n" if $seen{$name}++;
    copy($f, "$work/$name") or die "copy $f: $!\n";
}

for my $dir (@dirs) {
    for my $f (grep { -f && !/\.(tcl|out)$/ } glob "$dir/*") {
        my $name = uc basename($f);
        die "$f: $name is used twice\n" if $seen{$name}++;
        copy($f, "$work/$name") or die "copy $f: $!\n";
    }
}

# Exit status N passes when errorlevel >= N and not >= N + 1.
open my $cnf, '>', "$work/DOSBOX.CNF";
print $cnf <<~"END";
  [sdl]
  output=surface
  [dosbox]
  machine=cga
  [cpu]
  core=normal
  cputype=8086
  [autoexec]
  mount c "$work"
  c:
  call RUN.BAT
  exit
  END
close $cnf;

for my $c (@cases) {
    my ($n, $st) = @$c{qw(name status)};
    my @bat = ('@echo off', "$c->{command} >$n.OUT");
    push @bat, sprintf 'if errorlevel %d goto f', $st + 1 if $st < 255;
    push @bat, "if not errorlevel $st goto f";
    push @bat, "echo ok >$n.RC", 'goto d', ':f', "echo bad >$n.RC", ':d';
    open my $b, '>:raw', "$work/RUN.BAT";
    print $b map { "$_\r\n" } @bat;
    close $b;

    local $ENV{SDL_VIDEODRIVER} = 'dummy';
    local $ENV{SDL_AUDIODRIVER} = 'dummy';
    my $rc = system('sh', '-c', 'exec "$@" >"$0" 2>&1', "$work/$n.LOG",
        'timeout', '-s', 'KILL', $timeout,
        $dosbox, '-nogui', '-nomenu', '-conf', "$work/DOSBOX.CNF");
    $c->{timedout} = 1 if $rc >> 8 == 137;
}
# DOSBox-X may give a file it made any case.
my %dosfile = map { uc(basename($_)) => $_ } glob "$work/*";

my ($pass, $fail, $todo) = (0, 0, 0);
for my $c (@cases) {
    my $n = $c->{name};
    my @why;
    my $rc = $dosfile{"$n.RC"};
    my $out = $dosfile{"$n.OUT"};
    if (!defined $rc) {
        push @why, $c->{timedout} ? "timed out after ${timeout}s" : "did not finish";
    } else {
        push @why, "exit status is not $c->{status}"
            unless slurp($rc) =~ /^ok/;
        my $got = defined $out ? slurp($out) =~ s/\r\n/\n/gr : '';
        if ($got ne $c->{expect}) {
            push @why, 'output differs';
            open my $g, '>:raw', "$work/$n.GOT";
            print $g $got;
            close $g;
        }
    }
    if (my $log = $dosfile{"$n.LOG"}) {
        push @why, 'DOSBox-X: ' . $1
            if slurp($log) =~ /(E_Exit: [^\n]*|Write \S+ to rom[^\n]*)/;
    }
    if (!@why) {
        $pass++;
        say "ok    $n";
    } elsif ($c->{todo}) {
        $todo++;
        say "todo  $n: ", join('; ', @why), " ($c->{todo})";
    } else {
        $fail++;
        say "FAIL  $n: ", join('; ', @why);
    }
}
say "$pass passed, $fail failed, $todo todo (work directory $work)";
remove_tree($work) unless $fail || $ENV{KEEP};
exit($fail ? 1 : 0);
