Scan integers into a long (docs/M2-REPORT.md, section 5). Found by Tcl
6.7's own test suite (tests scan-1.21 to scan-1.24), which fails the same
way in both candidates, since they share Tcl_ScanCmd.

scan passed its format to sscanf as given and stored each "%d", "%o" or
"%x" field in an int, 16 bits on DOS, so out-of-range values wrapped
without an error: "scan 12345670 %o a" set a to -13384, not 2739128.
Tcl_ScanCmd now gives sscanf a copy of the format with an "l" before
each integer conversion (ScanLongFormat; "%D", "%O" and "%X" become
"%ld", "%lo" and "%lx"), stores the fields in longs and formats them
with "%ld": scan has the 32 bits it has on a 32-bit host, like expr,
incr and format (patches 0003).

diff -ru a/tclCmdMZ.c b/tclCmdMZ.c
--- a/tclCmdMZ.c
+++ b/tclCmdMZ.c
@@ -513,6 +513,66 @@
 }
 
 /*
+ * tcl16: ScanLongFormat returns a copy of a scan format, made with ckalloc,
+ * with an "l" before each integer conversion ("%d", "%o", "%x" and their
+ * upper-case forms, which become lower case), so that sscanf stores each
+ * integer field in a long: an int is 16 bits on DOS, and "%o" of
+ * 12345670 wrapped without an error. It follows Tcl_ScanCmd's own reading
+ * of the format: "%", an optional "*", digits, then the conversion.
+ */
+
+static char *
+ScanLongFormat(format)
+    char *format;
+{
+    char *copy, *dst, *src;
+
+    copy = (char *) ckalloc((unsigned) (2 * strlen(format) + 1));
+    for (src = format, dst = copy; *src != 0; ) {
+	if (*src != '%') {
+	    *dst++ = *src++;
+	    continue;
+	}
+	*dst++ = *src++;
+	if (*src == '%') {
+	    *dst++ = *src++;
+	    continue;
+	}
+	if (*src == '*') {
+	    *dst++ = *src++;
+	}
+	while (isdigit(*src)) {
+	    *dst++ = *src++;
+	}
+	switch (*src) {
+	    case 'D': case 'O': case 'X':
+		*dst++ = 'l';
+		*dst++ = *src++ - 'A' + 'a';
+		break;
+	    case 'd': case 'o': case 'x':
+		*dst++ = 'l';
+		*dst++ = *src++;
+		break;
+	    case '[':
+		do {
+		    *dst++ = *src++;
+		} while (*src != 0 && *src != ']');
+		if (*src != 0) {
+		    *dst++ = *src++;
+		}
+		break;
+	    case 0:
+		break;
+	    default:
+		*dst++ = *src++;
+		break;
+	}
+    }
+    *dst = 0;
+    return copy;
+}
+
