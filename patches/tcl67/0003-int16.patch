+
+/*
+ *----------------------------------------------------------------------
+ *
+ * TclGetLong --
+ *
+ *	Like Tcl_GetInt, for a long. tcl16: "incr" and "format" use it,
+ *	so that they work in 32 bits, as "expr" does, where int has 16.
+ *
+ * Results:
+ *	The return value is normally TCL_OK;  in this case *longPtr
+ *	will be set to the long value equivalent to string.  If
+ *	string is improperly formed then TCL_ERROR is returned and
+ *	an error message will be left in interp->result.
+ *
+ * Side effects:
+ *	None.
+ *
+ *----------------------------------------------------------------------
+ */
+
+int
+TclGetLong(interp, string, longPtr)
+    Tcl_Interp *interp;		/* Interpreter to use for error reporting. */
+    char *string;		/* String containing a (possibly signed)
+				 * integer in a form acceptable to strtol. */
+    long *longPtr;		/* Place to store converted result. */
+{
+    char *end;
+    long i;
+
+    errno = 0;
+    i = strtol(string, &end, 0);
+    while ((*end != '\0') && isspace(*end)) {
+	end++;
+    }
+    if ((end == string) || (*end != 0)) {
+	Tcl_AppendResult(interp, "expected integer but got \"", string,
+		"\"", (char *) NULL);
+	return TCL_ERROR;
+    }
+    if (errno == ERANGE) {
+	Tcl_AppendResult(interp, "integer value too large to represent: \"",
+		string, "\"", (char *) NULL);
+	return TCL_ERROR;
+    }
+    *longPtr = i;
     return TCL_OK;
 }
 
