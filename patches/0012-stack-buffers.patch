Keep Tiny Tcl's large buffers off the stack (docs/DESIGN.md, section 12).

The stack guard (patch 0004) stops Tcl_Eval with 3 KB of stack left; at
the deepest level it allows, a command has about 4.1 KB (measured with
m1probe). "read" kept a 4,097-byte buffer on the stack, enough to run past
the stack into BSS there; it now takes it from the heap. "pwd" kept
MAXPATHLEN + 1 bytes, 2,049 with libc16, which has no PATH_MAX; a DOS
path is at most 128 bytes with its NUL, and that is what it keeps now.

--- a/tcldosaz.c
+++ b/tcldosaz.c
@@ -1058,7 +1058,12 @@
     int argc;				/* Number of arguments. */
     char **argv;			/* Argument strings. */
 {
-    char buffer[MAXPATHLEN+1];
+    /*
+     * Tcl16: a DOS path, at most 128 bytes with its NUL, not MAXPATHLEN
+     * (2,048 here, libc16 has no PATH_MAX): a deep script must not run
+     * past the stack guard's margin (patches/0012-stack-buffers.patch).
+     */
+    char buffer[128];
 
     if (argc != 1) {
 	Tcl_AppendResult(interp, "wrong # args: should be \"",
@@ -1073,7 +1078,7 @@
 	    return TCL_ERROR;
 	}
 #else
-	if (getcwd(buffer, MAXPATHLEN) == NULL) {
+	if (getcwd(buffer, sizeof(buffer)) == NULL) {
 	    if (errno == ERANGE) {
 		interp->result = "working directory name is too long";
 	    } else {
@@ -1207,7 +1212,11 @@
     OpenFile *filePtr;
     int bytesLeft, bytesRead, count;
 #define READ_BUF_SIZE 4096
-    char buffer[READ_BUF_SIZE+1];
+    /*
+     * Tcl16: on the heap, not the stack: 4 KB is more than the stack
+     * guard's margin (patches/0012-stack-buffers.patch).
+     */
+    char *buffer;
     int newline, i;
 
     if ((argc != 2) && (argc != 3)) {
@@ -1264,6 +1273,7 @@
      * Read the file in one or more chunks.
      */
 
+    buffer = (char *) ckalloc(READ_BUF_SIZE+1);
     bytesRead = 0;
     while (bytesLeft > 0) {
 	count = READ_BUF_SIZE;
@@ -1276,6 +1286,7 @@
 	    Tcl_AppendResult(interp, "error reading \"", argv[i],
 		    "\": ", Tcl_UnixError(interp), (char *) NULL);
 	    clearerr(filePtr->f);
+	    ckfree(buffer);
 	    return TCL_ERROR;
 	}
 	if (count == 0) {
@@ -1286,6 +1297,7 @@
 	bytesLeft -= count;
 	bytesRead += count;
     }
+    ckfree(buffer);
     if ((newline == 0) && (bytesRead > 0)
 	    && (interp->result[bytesRead-1] == '\n')) {
 	interp->result[bytesRead-1] = 0;
