-    char *completeCommand;
-    Interp *iPtr = (Interp *) interp;
-    char lineBuf[256];
-    Tcl_CmdBuf cmdBuffer = Tcl_CreateCmdBuf();
-    FILE *fp;
-    int lineNumber = 0;
