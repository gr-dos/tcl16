-
-    while (fgets (lineBuf, sizeof(lineBuf) - 1, fp) != NULL) {
-        lineNumber++;
-        completeCommand = Tcl_AssembleCmd (cmdBuffer, lineBuf);
-        if (completeCommand != NULL) {
-            result = Tcl_Eval(interp, completeCommand, 0, &end);
