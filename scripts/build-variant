#!/bin/sh
#
# Build one measurement variant of TCL.EXE (docs/M1-REPORT.md, section 7)
# in VAR_OUT/NAME, from the assembled sources in VAR_SRC, with Open
# Watcom's runtime like the development build; and VAR_OUT/FREEMEM.EXE
# (tests/tools/freemem.c). Needs wcc and wlink on PATH (make variants,
# make variants-tcl67).
#
# usage: scripts/build-variant NAME
#
# Environment, for the candidate (defaults: Tiny Tcl, M1):
#   VAR_SRC     assembled sources (build/src)
#   VAR_OUT     output directory (build/var)
#   VAR_NAMES   the candidate's modules in VAR_SRC (Tiny Tcl's)
#   VAR_DEFS    more wcc options for every module (none)
#   VAR_T16     tcl16's modules in src/ (main stack probe)
#
#   os      -os, 32 KB stack: build/dev/TCL.EXE again
#   ox      -ox (speed), 32 KB stack
#   od      -od (no optimisation), 32 KB stack
#   stk16   -os, 16 KB stack
#   stk48   -os, 48 KB stack

set -eu

name=$1
case $name in
  os)    opt=-os; stack=32k ;;
  ox)    opt=-ox; stack=32k ;;
  od)    opt=-od; stack=32k ;;
  stk16) opt=-os; stack=16k ;;
  stk48) opt=-os; stack=48k ;;
  *) echo "build-variant: unknown variant $name" >&2; exit 1 ;;
esac

src=${VAR_SRC:-build/src}
top=${VAR_OUT:-build/var}
names=${VAR_NAMES:-tclGet tclProc tclVar tclAssem tclCmdAH tclCmdMZ tclHash \
  tclParse panic regexp tclCmdIL tclalloc tclBasic tclExpr tclUtil tclEnv \
  tcldosaz tcldosut tcldosst tcldosgl tclXdbg tclXgen readdir}
out=$top/$name
rm -rf "$out"
mkdir -p "$out"
flags="-q -zq -ml -0 -zc $opt -bt=dos -DTCL16_PROBE -DTCL16_STACKAVAIL ${VAR_DEFS:-} -I$src -I$WATCOM/h"
for m in $names; do
  wcc $flags -fo="$out/$m.obj" "$src/$m.c"
done
for m in ${VAR_T16:-main stack probe}; do
  wcc $flags -fo="$out/$m.obj" "src/$m.c"
done
{
  echo "option quiet, stack=$stack, map=$out/tcl.map"
  echo "system dos name $out/TCL.EXE"
  for o in "$out"/*.obj; do echo "file $o"; done
} > "$out/tcl.lnk"
wlink @"$out/tcl.lnk"

if [ ! -f "$top/FREEMEM.EXE" ]; then
  wcc -q -zq -ms -0 -bt=dos -I"$WATCOM/h" -fo="$top/freemem.obj" \
    tests/tools/freemem.c
  wlink option quiet system dos name "$top/FREEMEM.EXE" \
    file "$top/freemem.obj"
fi
